# Copy this file to .env and fill in your own keys:
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# Required: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Only needed if you switch image_generator.py to call the Hugging Face
# Inference API instead of running Stable Diffusion locally.
HF_API_KEY=your_huggingface_api_key_here

# --- Optional overrides (defaults shown) ---
# Gemini model aliases. "latest" aliases always point at Google's current
# recommended model, so the app keeps working as models are upgraded.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest

# Stable Diffusion checkpoint (Hugging Face repo id) and device.
# SD_DEVICE: auto | cuda | mps | cpu
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SD_DEVICE=auto
